{
  "version": 2,
  "crons": [
    {
      "path": "/api/daily_post",
      "schedule": "0 0 * * *"
    }
  ],
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "daily-report.html",
      "use": "@vercel/static"
    },
    {
      "src": "wash-schedule.html",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/slack_webhook.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/news_webhook.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/daily_post.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/slack_webhook",
      "dest": "/api/slack_webhook.py"
    },
    {
      "src": "/api/news_webhook",
      "dest": "/api/news_webhook.py"
    },
    {
      "src": "/api/daily_post",
      "dest": "/api/daily_post.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
